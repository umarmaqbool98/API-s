{
  "Jwt": {
    "Issuer": "MarksApi",
    "Audience": "MarksApiUsers",
    "LifetimeMinutes": 60
  },
  "PassMark": 50,
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
